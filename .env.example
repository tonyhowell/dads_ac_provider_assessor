# Copy to .env for local development. Never commit .env.

# Public address users visit. Passkeys are bound to this origin's hostname.
# Local dev (Vite on 5173 proxies /api to the server on 3000):
APP_ORIGIN=http://localhost:5173
# Production: APP_ORIGIN=https://assessor.quantivate.com.au

# Postgres connection string. Leave empty locally to use embedded PGlite in .data/pglite.
DATABASE_URL=

# On first start with an empty database, create this admin and print their enrolment link.
BOOTSTRAP_ADMIN_USERNAME=

# Drafting interview notes with Claude. Server-side only.
ANTHROPIC_API_KEY=

# Optional: RP_ID (defaults to APP_ORIGIN's hostname), RP_NAME, PORT (default 3000), DATA_DIR.

# Data check (price lists, extra sources, public claims). Unset = run it from Site administration or `npm run enrich`.
# Only pages that changed are read by Claude, so a daily check costs little.
ENRICH_EVERY_HOURS=
# Most full web searches for public claims in one scheduled run (default 3).
ENRICH_MAX_RESEARCH=

# Government aged care service list (AIHW GEN), imported automatically. A page that links to it, a release page,
# or the file itself. Admins can change it in Site administration. Default: GEN's "Providers of aged care" page.
GEN_SERVICE_LIST_URL=
# How often to check for a new list, in hours (default 168 = weekly; 0 = only when an admin asks).
GEN_IMPORT_EVERY_HOURS=
